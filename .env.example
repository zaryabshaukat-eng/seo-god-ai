# =============================================
# SEO GOD AI — Environment Variables
# Copy to .env and fill in real values.
# NEVER commit real .env files.
# =============================================

# --- App ---
NODE_ENV=development
PORT=3000

# --- Shopify ---
# Shopify Admin API credentials (see docs/shopify.md once available)
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_API_KEY=
SHOPIFY_ADMIN_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-07

# --- Database ---
DATABASE_URL=postgresql://seogod:seogod@localhost:5432/seogod

# --- Redis ---
REDIS_URL=redis://localhost:6379

# --- Crawler ---
# Respect robots.txt: recommended
CRAWLER_RESPECT_ROBOTS_TXT=true
CRAWLER_MAX_PAGES=5000
CRAWLER_RATE_LIMIT_MS=200

# --- AI ---
# Provider for AI agents (openai | anthropic | none)
AI_PROVIDER=none
AI_MODEL=
AI_API_KEY=

# --- Safety ---
# Require human approval for high-impact actions (always recommended)
SAFETY_REQUIRE_APPROVAL=true

# --- Reporting ---
REPORTS_OUTPUT_DIR=./reports-output
