{
  "name": "seo-god-ai",
  "version": "0.0.0",
  "private": true,
  "description": "AI-powered SEO Operating System for Shopify stores",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @seogod/core -w @seogod/config -w @seogod/shared -w @seogod/logging -w @seogod/shopify -w @seogod/database -w @seogod/audit -w @seogod/events -w @seogod/monitoring -w @seogod/agents -w @seogod/ai -w @seogod/crawler -w @seogod/reports -w @seogod/safety -w @seogod/seo-engine -w @seogod/knowledge-graph -w @seogod/decision-engine -w @seogod/ai-orchestrator -w @seogod/execution-engine -w @seogod/observability -w @seogod/google-integrations -w @seogod/learning-engine -w @seogod/scheduler -w @seogod/ui -w @seogod/api -w @seogod/dashboard --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "cycles": "depcruise apps packages --config .dependency-cruiser.cjs",
    "db:generate": "npm run db:generate --workspace @seogod/database --if-present"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "dependency-cruiser": "^16.6.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.18.0"
  }
}
