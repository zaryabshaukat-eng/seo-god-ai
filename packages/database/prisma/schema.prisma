// SEO GOD AI — domain schema
// Prisma schema for the platform's PostgreSQL database.
// See docs/database.md for the model reference.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CrawlStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  CANCELLED
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

/// A connected Shopify store and its encrypted access token.
model Store {
  id          String   @id @default(cuid())
  shopDomain  String   @unique
  accessToken String? // encrypted at rest via @seogod/shared AES-256-GCM
  scopes      String[] @default([])
  installedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  crawlJobs CrawlJob[]
  pages     Page[]
  approvals ApprovalRequest[]
  auditLogs AuditLog[]
}

/// A single crawl run over a store.
model CrawlJob {
  id         String      @id @default(cuid())
  storeId    String
  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status     CrawlStatus @default(PENDING)
  totalPages Int         @default(0)
  seeds      Json? // seed URLs crawled first
  statistics Json? // crawl summary: pages, skipped, failures, issues, duration
  error      String? // terminal error message for FAILED jobs
  createdAt  DateTime    @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  pages Page[]

  @@index([storeId, createdAt])
}

/// A crawled page snapshot for one crawl job.
model Page {
  id              String   @id @default(cuid())
  crawlJobId      String
  crawlJob        CrawlJob @relation(fields: [crawlJobId], references: [id], onDelete: Cascade)
  storeId         String
  store           Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  url             String
  finalUrl        String? // URL after redirects
  statusCode      Int?
  contentType     String?
  charset         String?
  title           String?
  metaDescription String?
  metaRobots      String? // raw robots meta directive
  canonicalUrl    String?
  lang            String?
  favicon         String?
  themeColor      String?
  ogTags          Json?
  twitterTags     Json?
  robotsBlocked   Boolean  @default(false) // blocked by robots.txt
  redirectChain   Json? // list of URLs followed before finalUrl
  h1              String?
  contentHash     String?
  wordCount       Int?
  ttfbMs          Int?
  responseTimeMs  Int?
  pageSizeBytes   Int?
  htmlSizeBytes   Int?
  scriptCount     Int?
  stylesheetCount Int?
  createdAt       DateTime @default(now())

  issues         SeoIssue[]
  links          PageLink[]
  structuredData PageStructuredData[]

  @@unique([crawlJobId, url])
  @@index([storeId, url])
}

/// A detected SEO issue on a page, produced by the SEO engine.
model SeoIssue {
  id        String   @id @default(cuid())
  pageId    String
  page      Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  rule      String
  severity  Severity @default(MEDIUM)
  message   String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([pageId])
}

/// A link extracted from a crawled page (internal and external).
model PageLink {
  id         String   @id @default(cuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  href       String // absolute, normalized target URL
  anchorText String?
  rel        String?
  isInternal Boolean
  isImage    Boolean  @default(false)
  statusCode Int? // populated for internal targets that were crawled
  createdAt  DateTime @default(now())

  @@index([pageId])
  @@index([href])
}

/// A structured-data block (JSON-LD / microdata / RDFa) on a page.
model PageStructuredData {
  id         String   @id @default(cuid())
  pageId     String
  page       Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)
  format     String // jsonld | microdata | rdfa
  schemaType String?
  valid      Boolean  @default(true)
  raw        Json // raw payload plus extracted schemas
  createdAt  DateTime @default(now())

  @@index([pageId])
}

/// Immutable audit trail entries (written via @seogod/audit).
model AuditLog {
  id           String   @id @default(cuid())
  storeId      String?
  actorType    String
  actorId      String?
  action       String
  resourceType String?
  resourceId   String?
  payload      Json?
  createdAt    DateTime @default(now())

  store Store? @relation(fields: [storeId], references: [id], onDelete: SetNull)

  @@index([storeId, createdAt])
  @@index([action, createdAt])
}

/// Transactional outbox for the event bus (@seogod/events).
model OutboxEvent {
  id            String       @id @default(cuid())
  type          String
  aggregateType String?
  aggregateId   String?
  payload       Json?
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  createdAt     DateTime     @default(now())
  processedAt   DateTime?

  @@index([status, nextAttemptAt])
}

/// Human approval requests for high-impact AI actions (@seogod/safety).
model ApprovalRequest {
  id          String         @id @default(cuid())
  storeId     String
  store       Store          @relation(fields: [storeId], references: [id], onDelete: Cascade)
  status      ApprovalStatus @default(PENDING)
  kind        String
  payload     Json
  rationale   String?
  requestedBy String?
  decidedBy   String?
  decidedAt   DateTime?
  createdAt   DateTime       @default(now())

  @@index([storeId, status])
}

/// A versioned snapshot of a store's knowledge graph (@seogod/knowledge-graph).
/// Every build creates a new version so the graph stays historical.
model GraphSnapshot {
  id                 String   @id @default(cuid())
  storeId            String
  version            Int
  label              String?
  source             String // what produced it, e.g. 'crawl.completed'
  previousSnapshotId String? // prior version id, when known
  summary            Json? // node/edge counts and build metadata
  createdAt          DateTime @default(now())

  nodes GraphNode[]
  edges GraphEdge[]

  @@unique([storeId, version])
  @@index([storeId, createdAt])
}

/// A node in the knowledge graph: page, product, collection, keyword, entity, ...
model GraphNode {
  id         String        @id @default(cuid())
  snapshotId String
  snapshot   GraphSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  storeId    String
  type       String // NodeType, e.g. 'page' | 'product' | 'keyword'
  externalId String // stable business key (normalized URL, slug, text key)
  name       String?
  properties Json?
  source     String // provenance: which crawler/engine data produced this node
  version    Int           @default(1)
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  outEdges GraphEdge[] @relation("GraphEdge_sourceNode")
  inEdges  GraphEdge[] @relation("GraphEdge_targetNode")

  @@unique([snapshotId, type, externalId])
  @@index([storeId, type])
}

/// A directed relationship between two graph nodes with explainable metadata.
model GraphEdge {
  id           String      @id @default(cuid())
  snapshotId   String
  snapshot     GraphSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  storeId      String
  type         String // EdgeType, e.g. 'links_to' | 'targets' | 'affects'
  sourceNodeId String
  sourceNode   GraphNode   @relation("GraphEdge_sourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNodeId String
  targetNode   GraphNode   @relation("GraphEdge_targetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)
  weight       Float       @default(1)
  confidence   Float       @default(1)
  source       String // provenance: which builder/rule produced this edge
  properties   Json? // evidence + explainability metadata
  createdAt    DateTime    @default(now())

  @@unique([snapshotId, type, sourceNodeId, targetNodeId])
  @@index([snapshotId, sourceNodeId])
  @@index([snapshotId, targetNodeId])
  @@index([storeId, type])
}
