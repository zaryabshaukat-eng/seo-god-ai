{
  "name": "@seogod/execution-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Autonomous execution engine: safely executes approved, validated, reversible, observable Shopify changes",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@seogod/core": "*",
    "@seogod/decision-engine": "*",
    "@seogod/events": "*",
    "@seogod/logging": "*",
    "@seogod/monitoring": "*",
    "@seogod/shopify": "*"
  },
  "devDependencies": {
    "@prisma/client": "*",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
