{
  "name": "@seogod/knowledge-graph",
  "version": "0.0.0",
  "private": true,
  "description": "Enterprise SEO knowledge graph: canonical relationship layer storing and querying relationships between SEO entities",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@prisma/client": "^6.2.0",
    "@seogod/core": "*",
    "@seogod/crawler": "*",
    "@seogod/database": "*",
    "@seogod/events": "*",
    "@seogod/logging": "*",
    "@seogod/monitoring": "*",
    "@seogod/seo-engine": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^3.0.0",
    "vitest": "^3.0.0"
  }
}
