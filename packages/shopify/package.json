{
  "name": "@seogod/shopify",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable Shopify Admin API SDK: OAuth, GraphQL client, typed service layer, secure token storage",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@seogod/core": "*",
    "@seogod/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "vitest": "^3.0.0"
  }
}
